{
  "graph": {
    "root": "/path/to/raw_data_root",
    "source": "TGL-DATA/WIKI",
    "node_feat": null,
    "event_snapshot_bins": 12,
    "max_events": 20000
  },
  "model": {
    "name": "tgcn",
    "hidden_dim": 64
  },
  "gnn": {
    "history": 1,
    "gcn_layers": 1,
    "full_graph": {
      "chunk_order": "identity",
      "disable_states": false
    },
    "slice_config": {
      "chunk_decay": [1],
      "num_full_snapshots": 1
    }
  },
  "task": {
    "name": "node_regression"
  },
  "preprocess": {
    "use_new_pipeline": true,
    "partition_algorithm": "chunk_load_balance",
    "chunks_per_rank": 2,
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "lags": 1
  },
  "runtime": {
    "route_check_batches": 2
  },
  "train": {
    "epochs": 1,
    "lr": 0.01
  }
}
