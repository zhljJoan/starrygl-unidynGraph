{
  "graph": {
    "root": "/path/to/raw_data_root",
    "source": "TGL-DATA/WIKI"
  },
  "model": {
    "name": "general",
    "hidden_dim": 64
  },
  "gnn": {
    "history": 1,
    "gnn_arch": "identity",
    "layers": 1,
    "memory_update": "rnn",
    "memory_history": 1,
    "sampling": {
      "fanouts": [10],
      "policy": "boundary_recent_uniform",
      "probability": 0.1
    }
  },
  "task": {
    "name": "edge_prediction",
    "batch_size": 1024
  },
  "preprocess": {
    "use_new_pipeline": true,
    "partition_algorithm": "chunk_load_balance",
    "chunks_per_rank": 2,
    "build_feature": true
  },
  "runtime": {
    "build_feature_runtime": true,
    "build_memory_runtime": true,
    "build_mailbox_runtime": true,
    "memory_dim": 64,
    "mailbox_size": 1,
    "negative_ratio": 1,
    "predict_updates_memory": true,
    "eval_updates_memory": false
  },
  "train": {
    "epochs": 1,
    "lr": 0.001
  }
}
