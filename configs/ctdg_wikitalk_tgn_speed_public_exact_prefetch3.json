{
  "graph": {
    "source": "/mnt/data/zlj/tgl_data/DATA/wikitalk",
    "random_node_feat_dim": 172,
    "random_node_feat_seed": 0,
    "random_edge_feat_dim": 172,
    "random_edge_feat_seed": 0,
    "random_feature_seed_mode": "bts"
  },
  "model": {
    "name": "general",
    "hidden_dim": 100,
    "dim_time": 100,
    "gnn_arch": "transformer_attention",
    "layers": 1,
    "att_head": 2,
    "memory_update": "gru",
    "memory_history": 1,
    "combine_node_feature": true,
    "dropout": 0.2,
    "att_dropout": 0.2
  },
  "gnn": {
    "history": 1,
    "sampling": {
      "fanouts": [
        20
      ],
      "policy": "recent",
      "probability": 0.1
    }
  },
  "task": {
    "name": "edge_prediction",
    "batch_size": 12000
  },
  "preprocess": {
    "use_new_pipeline": true,
    "partition_algorithm": "speed_partition",
    "hot_ratio": 0.1,
    "chunks_per_rank": 2,
    "build_feature": true,
    "batch_size": 12000,
    "split_mode": "adaptive",
    "adaptive_split": true,
    "adaptive_split_min_batch_size": 12000,
    "adaptive_split_max_batch_size": 48000,
    "adaptive_split_coherence_chunks": 8,
    "adaptive_split_max_chunk_entropy_ratio": 0.9,
    "adaptive_split_fallback": true,
    "train_ratio": 0.7,
    "val_ratio": 0.15
  },
  "runtime": {
    "memory_sync_mode": "memshare_public_exact",
    "build_sampler": true,
    "sampler_workers": 4,
    "torch_num_threads": 1,
    "torch_num_interop_threads": 1,
    "omp_num_threads": 1,
    "mkl_num_threads": 1,
    "openblas_num_threads": 1,
    "build_feature_runtime": true,
    "feature_device": "cuda",
    "chunk_feature_layout": true,
    "chunk_feature_sort_gather": false,
    "build_memory_runtime": true,
    "build_mailbox_runtime": true,
    "memory_dim": 100,
    "mailbox_size": 1,
    "mailbox_msg_dim": 372,
    "negative_ratio": 1,
    "negative_sampler_policy": "memshare_local",
    "negative_dst_pool": "global_dst",
    "negative_train_remote_dst_prob": 0.1,
    "prefetch_sample_lookahead": 3,
    "predict_updates_memory": true,
    "eval_updates_memory": false,
    "commit_memory": true,
    "memory_replica_push": false,
    "mailbox_replica_push": false,
    "reset_memory_each_epoch": true,
    "gradient_sync": "async",
    "train_compute_metrics": false,
    "schedule_async_commit": true,
    "historical": {
      "enabled": true,
      "alpha": 0.1,
      "times_threshold": 10
    },
    "async_memory": {
      "shared_filter": true,
      "staged_commit": false,
      "commit_order": "legacy",
      "delta_compensation": false,
      "historical_blend": false
    }
  },
  "train": {
    "epochs": 3,
    "lr": 0.0004,
    "weight_decay": 0.0001
  }
}
