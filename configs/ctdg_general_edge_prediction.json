{
  "graph": {
    "source": "/path/to/event_data"
  },
  "model": {
    "name": "general",
    "hidden_dim": 64,
    "gnn_arch": "identity",
    "layers": 1,
    "history": 1,
    "memory_update": "gru"
  },
  "sampling": {
    "fanouts": [10],
    "policy": "uniform"
  },
  "task": {
    "name": "edge_prediction",
    "batch_size": 1024
  },
  "preprocess": {
    "use_new_pipeline": true,
    "partition_algorithm": "chunk_load_balance",
    "chunks_per_rank": 2,
    "build_feature": true
  },
  "runtime": {
    "build_sampler": true,
    "build_feature_runtime": true,
    "build_memory_runtime": true,
    "build_mailbox_runtime": true,
    "memory_dim": 64,
    "mailbox_size": 1,
    "negative_ratio": 1,
    "predict_updates_memory": true,
    "eval_updates_memory": false
  },
  "train": {
    "epochs": 1,
    "lr": 0.001
  }
}
